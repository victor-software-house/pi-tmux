{
  "name": "@victor-software-house/pi-tmux",
  "version": "1.3.2",
  "type": "module",
  "description": "Pi coding agent extension: tmux session management per project",
  "repository": {
    "type": "git",
    "url": "https://github.com/victor-software-house/pi-tmux.git"
  },
  "keywords": [
    "pi-package",
    "pi-extension",
    "tmux"
  ],
  "license": "MIT",
  "scripts": {
    "test": "pnpm exec bun test",
    "typecheck": "tsc --noEmit",
    "check": "pnpm run typecheck && pnpm run test",
    "prepare": "lefthook install",
    "release": "pnpm exec semantic-release",
    "prepublishOnly": "pnpm run typecheck && pnpm run test"
  },
  "pi": {
    "extensions": [
      "./extensions"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": ">=0.74.0",
    "@earendil-works/pi-coding-agent": ">=0.74.0",
    "@earendil-works/pi-tui": ">=0.74.0",
    "@sinclair/typebox": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-ai": {
      "optional": true
    },
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "@earendil-works/pi-tui": {
      "optional": true
    }
  },
  "devDependencies": {
    "@commitlint/cli": "^20.5.0",
    "@commitlint/config-conventional": "^20.5.0",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^12.0.6",
    "@semantic-release/npm": "^13.1.5",
    "@sinclair/typebox": "^0.34.48",
    "@types/node": "^25.7.0",
    "bun-types": "^1.3.11",
    "lefthook": "^2.1.5",
    "semantic-release": "^25.0.3"
  },
  "packageManager": "pnpm@11.1.1",
  "engines": {
    "node": ">=24.0.0"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  },
  "pnpm": {
    "autoInstallPeers": false
  }
}
